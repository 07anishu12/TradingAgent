# Local Qwen3 Instruct profile created from examples/ollama/Qwen3.Modelfile.
# No LLM API key is required.
TRADINGAGENTS_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
TRADINGAGENTS_DEEP_THINK_LLM=qwen3:4b-tradingagents
TRADINGAGENTS_QUICK_THINK_LLM=qwen3:4b-tradingagents
TRADINGAGENTS_MAX_DEBATE_ROUNDS=2
TRADINGAGENTS_MAX_RISK_ROUNDS=2
TRADINGAGENTS_MAX_TOKENS=1536
TRADINGAGENTS_LLM_MAX_RETRIES=2
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_OUTPUT_LANGUAGE=English
